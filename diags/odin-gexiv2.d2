# odin-gexiv2: its place in the binding graph
# Render:  d2 diags/odin-gexiv2.d2 diags/odin-gexiv2.svg

direction: down

title: "odin-gexiv2" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-gexiv2\ngexiv2 0.14.2" {
  style.fill: "#eef6ff"
}
lib: "gexiv2 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"gexiv2:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection gexiv2
this -> lib: foreign import
